# Local application
DEBUG=true
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://flowdesk:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/flowdesk
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800
DB_SSL_ROOT_CERT=
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Rate limits
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=8/minute
RATE_LIMIT_PASSWORD_RESET=5/hour
RATE_LIMIT_API=80/minute
RATE_LIMIT_AI=8/minute
RATE_LIMIT_COMPILER=30/minute
RATE_LIMIT_COMPILER_RUN=6/minute
RATE_LIMIT_SEARCH=40/minute

# Frontend build
VITE_API_URL=http://localhost:8000/api/v1

# AI providers
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Google OAuth - backend only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Transactional email
RESEND_API_KEY=
FROM_EMAIL=noreply@example.com

# Lemon Squeezy
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_TEST_MODE=true

# Compiler
COMPILER_EXECUTION_ENABLED=true
COMPILER_TIMEOUT_SECONDS=12
COMPILER_MAX_CODE_CHARS=120000
COMPILER_MAX_STDIN_CHARS=20000
COMPILER_MAX_OUTPUT_CHARS=50000
COMPILER_MAX_GLOBAL_CONCURRENT_RUNS=2
COMPILER_MAX_CONCURRENT_RUNS_PER_USER=1
COMPILER_RUN_CACHE_MAX_ENTRIES=300
COMPILER_RUN_CACHE_TTL_SECONDS=600
COMPILER_PISTON_API_URL=

# Optional monitoring
SENTRY_DSN=
